# Build output: bare-named executables mirroring the on-device /bin
/bin/

# Build output: test/diagnostic program binaries, deliberately kept
# separate from /bin/ above
/test/bin/

# SDK and release packages (see "make sdk", "make release",
# "nmake /F Makefile.win sdk")
/dist/
/build/

# Prerequisites
*.d

# Listing files
*.lst

# Build number files
*.build

# Object files
*.o
*.ko
*.obj
*.elf
*.prg

# Linker output
*.ilk
*.map
*.exp
*.lkb
*.bin

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Claude Code local tooling state (permission allowlists etc.) --
# accumulated tool-approval history, not project source or shared config
/.claude/

# Python bytecode cache (tools/rom_info.py imports tools/split_kernel.py)
__pycache__/
