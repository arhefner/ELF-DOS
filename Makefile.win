#------------------------------------------------------------------
# Link rules (boot/kernel)
#------------------------------------------------------------------

$(MBR_BIN): boot\mbr.prg
	$(LINK) $(LFLAGS) -o $(MBR_BIN) boot\mbr.prg

$(KRNBOOT_BIN): boot\krnboot.prg
	$(LINK) $(LFLAGS) -o $(KRNBOOT_BIN) boot\krnboot.prg

# python3 (any recent version, on PATH) runs the same margin guard the
# Linux build does -- see tools\check_kernel_margin.py's own header.
# Catches a real bug class (an uninitialized kernel buffer silently left
# out of the linked binary) before it ever reaches hardware.
$(KERNEL_BIN): $(KOBJ)
	$(LINK) $(LFLAGS) -o $(KERNEL_BIN) $(KOBJ)
	python3 tools\check_kernel_margin.py

#------------------------------------------------------------------
# Build the final install image from the bootstrap and the two kernel
# regions. The kernel links as ONE file spanning both regions with a
# large zero gap between them (see include\memmap.inc), so it cannot be
# written to disk as-is -- tools\split_kernel.py slices it at the
# kvol_end marker, pads the volatile half to a sector boundary, and
# concatenates krnboot + volatile + non-volatile, patching both sector
# counts into krnboot's header as it goes. Same tool, same invocation
# shape as the Linux Makefile's own $(FULL_BIN) rule -- it does its own
# os.chdir()/relies on forward-slash-safe Python path handling, so it
# needs no Windows-specific changes itself.
#------------------------------------------------------------------
KVOL_BIN    = kvol.bin
KNV_BIN     = knv.bin

$(FULL_BIN): $(KRNBOOT_BIN) $(KERNEL_BIN)
	python3 tools\split_kernel.py $(KERNEL_BIN) $(KVOL_BIN) $(KNV_BIN) $(KRNBOOT_BIN) $(FULL_BIN) $(KOBJ)

#------------------------------------------------------------------
# Convenience targets
#------------------------------------------------------------------

mbr: $(MBR_BIN)

# Build every progs\*.asm into bin\<name> (bare name, no extension --
# matches the on-device \bin layout), plus bin\batch.mod (the loadable
# batch-script module -- required for .bat scripts to work at all,
# matching the Linux Makefile's own "progs: $(PROG_EXES) bin/batch.mod").
# The SPECIAL_BINS programs get real nmake incremental rebuilds;
# everything else is auto-discovered and (re)built by build_progs.bat --
# see this file's own header comment for why the split exists.
progs: bin $(SPECIAL_BINS) bin\batch.mod
	.\build_progs.bat "$(ASM)" "$(ASMFLAGS)" "$(LINK)" "$(LFLAGS)"

# Build every test\*.asm into test\bin\<name> -- diagnostic/subsystem-
# exercising programs, kept out of bin\ entirely so a normal install's
# \bin never includes them. Same split as "progs" above: the
# TEST_SPECIAL_BINS ones via real nmake rules, everything else
# auto-discovered by build_test.bat.
test: test\bin $(TEST_SPECIAL_BINS)
	.\build_test.bat "$(ASM)" "$(ASMFLAGS)" "$(LINK)" "$(LFLAGS)"

# everything: all + progs + test. Use this after "clean", which removes
# bin\ and test\bin\ while the default "all" rebuilds only the kernel --
# a bare "clean" then "all" leaves a tree with no programs at all.
# Deliberately excludes "sdk", which packages a release archive rather
# than building the system.
# Includes "mbr": mbr.bin is a build output, not a packaging step, and
# both "install" and the emulator's mkdisk.sh read it straight out of
# this directory.
everything: all mbr progs test

# sys\elfdos-sys.exe: the host-side installer, compiled from sys\sys.c
# with MSVC (see this file's own header comment). cd's into sys\ to
# match cl's own default output-naming convention (plain "cl sys.c"
# would otherwise produce sys.exe, not elfdos-sys.exe) -- same "cd DIR
# && tool file" shape every asm02 rule above already uses.
sys\elfdos-sys.exe: sys\sys.c
	cd sys && $(SYSCC) $(SYSCFLAGS) /Fe:elfdos-sys.exe sys.c

# Full install: write MBR boot code and kernel to disk. Use this when
# setting up a new disk or after changing the MBR. check_dev.bat refuses
# to run at all if DEV wasn't given explicitly -- see this file's own
# header comment for why there's no default to fall back to.
install: $(FULL_BIN) $(MBR_BIN) sys\elfdos-sys.exe
	.\check_dev.bat "$(DEV)" install
	$(SYS) -m $(MBR_BIN) -k $(FULL_BIN) $(DEV)

# Kernel-only update: MBR already on disk, just refresh the kernel.
# Faster for routine kernel development and testing cycles.
update: $(FULL_BIN) sys\elfdos-sys.exe
	.\check_dev.bat "$(DEV)" update
	$(SYS) -k $(FULL_BIN) $(DEV)

# SDK package -- a single self-contained elfdos-sdk.zip a developer
# downloads and expands directly into their own project. Windows
# counterpart to the Linux Makefile's own "sdk" target (elfdos-
# sdk.tar.gz) -- see that target's own header comment in Makefile for
# the full rationale. All the real work (staging, MANIFEST.txt, the
# zip itself) lives in tools\build_sdk.ps1 -- see its own header
# comment for why this is a standalone script rather than inlined
# nmake recipe lines. Override the output path with SDK_OUT, e.g.:
#   nmake /F Makefile.win sdk SDK_OUT=dist\x.zip
# (nmake has no GNU-Make-style $(if ...) to make this argument
# optional, so SDK_OUT just carries the same default the .ps1 script's
# own -OutFile parameter would fall back to anyway, and is always
# passed explicitly.)
SDK_OUT = elfdos-sdk.zip

sdk:
	powershell -NoProfile -ExecutionPolicy Bypass -File tools\build_sdk.ps1 -OutFile "$(SDK_OUT)"

clean:
	-del /F /Q boot\*.prg boot\*.lst
	-del /F /Q kernel\*.prg kernel\*.lst
	-del /F /Q progs\*.prg progs\*.lst progs\*.build progs\*.lkb
	-del /F /Q test\*.prg test\*.lst test\*.build test\*.lkb
	-del /F /Q lib\*.prg lib\*.lst
	-del /F /Q sys\elfdos-sys.exe sys\sys.obj
	-del /F /Q $(MBR_BIN) $(KRNBOOT_BIN) $(KERNEL_BIN) $(FULL_BIN)
	-del /F /Q $(KVOL_BIN) $(KNV_BIN) ksym.sym
	-del /F /Q $(SDK_OUT)
	-if exist bin rmdir /S /Q bin
	-if exist test\bin rmdir /S /Q test\bin
	-if exist build rmdir /S /Q build
