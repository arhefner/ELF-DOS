#
# Makefile.win - ELF-DOS kernel build (Windows nmake port)
#
# Usage:
#   nmake /F Makefile.win            build kernel-full.bin (default)
#   nmake /F Makefile.win mbr        build mbr.bin only
#   nmake /F Makefile.win progs      build every progs\*.asm into bin\<name>
#   nmake /F Makefile.win test       build every test\*.asm into test\bin\<name>
#   nmake /F Makefile.win install DEV=\\.\PhysicalDriveN
#                                     build everything and write MBR +
#                                     kernel to a raw device
#   nmake /F Makefile.win update DEV=\\.\PhysicalDriveN
#                                     build and write kernel only (MBR
#                                     already installed)
#   nmake /F Makefile.win clean      remove all generated files
#
# Mirrors the project's Linux Makefile as closely as nmake allows -- see
# that file for the authoritative build design. Differences are called
# out below. Assumes asm02.exe and link02.exe are already on PATH.
#
# "install"/"update" (writing kernel-full.bin + mbr.bin to a raw device
# via sys\elfdos-sys.exe): sys/sys.c is genuinely cross-platform (a real
# #ifdef _WIN32 block using the Win32 API for raw disk I/O -- see its own
# header comment) -- the earlier version of this file's own note calling
# it "a Linux binary... with no Windows build here" was stale/wrong.
# Built here via cl (MSVC, expected on PATH from a Developer Command
# Prompt, matching sys.c's own documented "cl sys.c /Fe:elfdos-sys.exe"
# invocation) -- if you only have MinGW, build it by hand instead
# ("cd sys && gcc -o elfdos-sys.exe sys.c") and this rule will see the
# result already up to date. DEV has NO default here (unlike the Linux
# Makefile's own DEV=/dev/mmcblk0, a safe default only because that's one
# person's own dev machine's fixed SD-reader path) -- a wrong physical-
# drive guess on an arbitrary Windows machine can destroy data with no
# recovery, so install/update refuse to run at all until DEV is given
# explicitly on the command line.
#
# DIFFERENCE FROM THE LINUX MAKEFILE: nmake has no equivalent of GNU
# Make's $(wildcard ...)/$(patsubst ...), so "progs"/"test" can't build a
# real per-file dependency graph for arbitrary progs\*.asm/test\*.asm the
# way the Linux Makefile does. Every progs\*.asm that links against lib\
# (SPECIAL_BINS below) and every test\*.asm that does (TEST_SPECIAL_BINS
# below) gets a real, explicit nmake rule -- same set the Linux Makefile
# itself gives an explicit override rule to, and for the same reason:
# each needs an extra lib\*.prg linked in, which a generic single-file
# rule can't express. Every OTHER progs\*.asm/test\*.asm file needs no
# entry here at all -- it's auto-discovered (no Makefile.win edit needed
# for a new one) and built by the companion scripts build_progs.bat/
# build_test.bat, which this Makefile calls. Keep SPECIAL_BINS/
# TEST_SPECIAL_BINS below in sync with those two scripts' own skip
# lists -- a program in one but not the other either fails to build
# (missing from both) or gets built twice (missing from the skip list
# while still having its own explicit rule here).
#
# CAUGHT UP (this pass): this file had fallen behind the Linux
# Makefile's own lib\-linked program set for a while -- badly enough
# that the kernel itself would have failed to link at all (KOBJ was
# missing lib\modload.prg/lib\icall.prg, both required by
# kernel\batch.asm's own extrn mod_load/mod_release/icall), the loadable
# batch-script module (bin\batch.mod) was never built here, and three
# already-listed programs (ls, edlin, move) were missing a lib\*.prg
# they now need, so linking them would have failed too. All fixed below,
# together with the 9 programs (dir, label, pwd, del, touch, copy,
# attrib, stat, chkdsk) and 2 test programs (big64test, corrupt) that
# had no Makefile.win entry at all. This file's own header comment used
# to carry a running note about exactly this gap -- removed now that
# it's closed; if it opens again, that's the place to look.
#

ASM         = asm02
ASMFLAGS    = -L -C -I .. -r
LINK        = link02
LFLAGS      = -b -be -r

# ---- Host-side installer (sys\sys.c -> sys\elfdos-sys.exe) ----
SYSCC       = cl
SYSCFLAGS   = /nologo /O2
SYS         = sys\elfdos-sys.exe

# DEV: no default (see this file's own header comment for why). Override
# on the command line, e.g.:
#   nmake /F Makefile.win install DEV=\\.\PhysicalDrive1
DEV         =

# ---- Output files (all land in project root) ----
MBR_BIN     = mbr.bin
KRNBOOT_BIN = krnboot.bin
KERNEL_BIN  = kernel.bin
FULL_BIN    = kernel-full.bin

# ---- Kernel object files (in kernel\ subdir, link order matters) ----
# lib\modload.prg/lib\icall.prg (loadable-module support, needed by
# kernel\batch.asm's own dispatcher) MUST be part of this list -- the
# kernel link fails with unresolved symbols (mod_load, mod_release,
# icall) without them, same as on Linux.
KOBJ =  kernel\kernel.prg  \
        kernel\fat.prg     \
        kernel\dir.prg     \
        kernel\path.prg    \
        kernel\rtc.prg     \
        kernel\file.prg    \
        kernel\loader.prg  \
        kernel\batch.prg   \
        kernel\redir.prg   \
        kernel\glob.prg    \
        lib\modload.prg    \
        lib\icall.prg

# ---- Common include dependencies ----
INCS =  include\bios.inc    \
        include\opcodes.def \
        include\kernel.inc

# ---- The progs\*.asm that link against lib\ -- see build_progs.bat's
# own exclusion list, which must be kept in sync with this set ----
SPECIAL_BINS = bin\printenv bin\export bin\unset \
        bin\ls bin\more bin\edlin bin\move bin\xcopy bin\shell \
        bin\yr bin\ys \
        bin\dir bin\label bin\pwd bin\del bin\touch bin\copy bin\attrib \
        bin\stat bin\chkdsk

# ---- The test\*.asm that link against lib\ -- see build_test.bat's
# own exclusion list, which must be kept in sync with this set ----
TEST_SPECIAL_BINS = test\bin\envtest test\bin\bumptest test\bin\malloctest \
        test\bin\big64test test\bin\corrupt

all: $(FULL_BIN)

#------------------------------------------------------------------
# Assembly rules -- asm02 places output alongside the source file, so
# .prg files live in the same directory as their .asm source. The cd
# ensures asm02 finds #include files via its own relative -I ..
#------------------------------------------------------------------

boot\mbr.prg: boot\mbr.asm include\bios.inc include\opcodes.def
	cd boot && $(ASM) $(ASMFLAGS) mbr.asm

boot\krnboot.prg: boot\krnboot.asm $(INCS)
	cd boot && $(ASM) $(ASMFLAGS) krnboot.asm

kernel\kernel.prg: kernel\kernel.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) kernel.asm

kernel\fat.prg: kernel\fat.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) fat.asm

kernel\dir.prg: kernel\dir.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) dir.asm

kernel\path.prg: kernel\path.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) path.asm

kernel\rtc.prg: kernel\rtc.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) rtc.asm

kernel\file.prg: kernel\file.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) file.asm

kernel\loader.prg: kernel\loader.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) loader.asm

kernel\batch.prg: kernel\batch.asm $(INCS) include\batchmod.inc
	cd kernel && $(ASM) $(ASMFLAGS) batch.asm

kernel\redir.prg: kernel\redir.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) redir.asm

kernel\glob.prg: kernel\glob.asm $(INCS)
	cd kernel && $(ASM) $(ASMFLAGS) glob.asm

# kernel\batch_mod.asm: the loadable batch-script module -- NOT part of
# KOBJ/kernel.bin. A standalone build (own "-m" module link, see the
# Linux Makefile's own bin/batch.mod rule), landing on disk as
# bin\batch.mod and loaded fresh into RAM by kernel\batch.asm's own
# dispatcher whenever a .bat script runs. Without this, batch scripting
# doesn't work at all on a card built from this Makefile.
kernel\batch_mod.prg: kernel\batch_mod.asm include\opcodes.def include\bios.inc include\kernel_api.inc include\batchmod.inc include\modformat.inc
	cd kernel && $(ASM) $(ASMFLAGS) batch_mod.asm

bin\batch.mod: kernel\batch_mod.prg bin
	$(LINK) $(LFLAGS) -m -o bin\batch.mod kernel\batch_mod.prg
	-del /F /Q bin\batch.lkb

bin:
	if not exist bin mkdir bin

test\bin:
	if not exist test\bin mkdir test\bin

#------------------------------------------------------------------
# Reusable libraries (lib\ subdir) -- NOT standalone programs, no EDF
# header/entry point of their own; assembled separately and linked
# alongside whichever program wants them. See the Linux Makefile's own
# comment on this for the full reasoning.
#------------------------------------------------------------------
lib\heap_bump.prg: lib\heap_bump.asm include\opcodes.def
	cd lib && $(ASM) $(ASMFLAGS) heap_bump.asm

lib\heap_malloc.prg: lib\heap_malloc.asm include\opcodes.def
	cd lib && $(ASM) $(ASMFLAGS) heap_malloc.asm

lib\env.prg: lib\env.asm include\opcodes.def include\kernel_api.inc
	cd lib && $(ASM) $(ASMFLAGS) env.asm

lib\move.prg: lib\move.asm include\opcodes.def include\kernel_api.inc
	cd lib && $(ASM) $(ASMFLAGS) move.asm

lib\ymodem.prg: lib\ymodem.asm include\opcodes.def include\bios.inc include\kernel_api.inc
	cd lib && $(ASM) $(ASMFLAGS) ymodem.asm

lib\fmt32.prg: lib\fmt32.asm include\opcodes.def
	cd lib && $(ASM) $(ASMFLAGS) fmt32.asm

lib\file_glob.prg: lib\file_glob.asm include\opcodes.def include\bios.inc include\kernel_api.inc include\file_glob.inc
	cd lib && $(ASM) $(ASMFLAGS) file_glob.asm

lib\pathstr.prg: lib\pathstr.asm include\opcodes.def include\bios.inc include\kernel_api.inc
	cd lib && $(ASM) $(ASMFLAGS) pathstr.asm

lib\vollabel.prg: lib\vollabel.asm include\opcodes.def include\kernel_api.inc include\vollabel.inc
	cd lib && $(ASM) $(ASMFLAGS) vollabel.asm

lib\lineedit.prg: lib\lineedit.asm include\opcodes.def include\bios.inc include\kernel_api.inc include\lineedit.inc
	cd lib && $(ASM) $(ASMFLAGS) lineedit.asm

lib\icall.prg: lib\icall.asm include\opcodes.def
	cd lib && $(ASM) $(ASMFLAGS) icall.asm

lib\modload.prg: lib\modload.asm include\opcodes.def include\bios.inc include\kernel_api.inc
	cd lib && $(ASM) $(ASMFLAGS) modload.asm

#------------------------------------------------------------------
# The progs\*.asm that link against lib\ -- explicit rules, real
# incremental rebuilds, matching the Linux Makefile's own overrides for
# the exact same set (see its own comment for why: each needs an extra
# lib\*.prg linked in, which the generic single-file case doesn't).
#------------------------------------------------------------------
test\envtest.prg: test\envtest.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd test && $(ASM) $(ASMFLAGS) envtest.asm

test\bin\envtest: test\envtest.prg lib\env.prg test\bin
	$(LINK) $(LFLAGS) -o test\bin\envtest test\envtest.prg lib\env.prg
	-del /F /Q test\bin\envtest.lkb

progs\printenv.prg: progs\printenv.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) printenv.asm

bin\printenv: progs\printenv.prg lib\env.prg bin
	$(LINK) $(LFLAGS) -o bin\printenv progs\printenv.prg lib\env.prg
	-del /F /Q bin\printenv.lkb

progs\export.prg: progs\export.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) export.asm

bin\export: progs\export.prg lib\env.prg bin
	$(LINK) $(LFLAGS) -o bin\export progs\export.prg lib\env.prg
	-del /F /Q bin\export.lkb

progs\unset.prg: progs\unset.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) unset.asm

bin\unset: progs\unset.prg lib\env.prg bin
	$(LINK) $(LFLAGS) -o bin\unset progs\unset.prg lib\env.prg
	-del /F /Q bin\unset.lkb

test\bumptest.prg: test\bumptest.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd test && $(ASM) $(ASMFLAGS) bumptest.asm

test\bin\bumptest: test\bumptest.prg lib\heap_bump.prg test\bin
	$(LINK) $(LFLAGS) -o test\bin\bumptest test\bumptest.prg lib\heap_bump.prg
	-del /F /Q test\bin\bumptest.lkb

progs\xcopy.prg: progs\xcopy.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) xcopy.asm

bin\xcopy: progs\xcopy.prg lib\heap_bump.prg bin
	$(LINK) $(LFLAGS) -o bin\xcopy progs\xcopy.prg lib\heap_bump.prg
	-del /F /Q bin\xcopy.lkb

test\malloctest.prg: test\malloctest.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd test && $(ASM) $(ASMFLAGS) malloctest.asm

test\bin\malloctest: test\malloctest.prg lib\heap_malloc.prg test\bin
	$(LINK) $(LFLAGS) -o test\bin\malloctest test\malloctest.prg lib\heap_malloc.prg
	-del /F /Q test\bin\malloctest.lkb

test\big64test.prg: test\big64test.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd test && $(ASM) $(ASMFLAGS) big64test.asm

test\bin\big64test: test\big64test.prg lib\fmt32.prg test\bin
	$(LINK) $(LFLAGS) -o test\bin\big64test test\big64test.prg lib\fmt32.prg
	-del /F /Q test\bin\big64test.lkb

test\corrupt.prg: test\corrupt.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd test && $(ASM) $(ASMFLAGS) corrupt.asm

test\bin\corrupt: test\corrupt.prg lib\ymodem.prg lib\fmt32.prg test\bin
	$(LINK) $(LFLAGS) -o test\bin\corrupt test\corrupt.prg lib\ymodem.prg lib\fmt32.prg
	-del /F /Q test\bin\corrupt.lkb

progs\ls.prg: progs\ls.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) ls.asm

bin\ls: progs\ls.prg lib\heap_bump.prg lib\env.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\ls progs\ls.prg lib\heap_bump.prg lib\env.prg lib\file_glob.prg
	-del /F /Q bin\ls.lkb

progs\more.prg: progs\more.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) more.asm

bin\more: progs\more.prg lib\env.prg bin
	$(LINK) $(LFLAGS) -o bin\more progs\more.prg lib\env.prg
	-del /F /Q bin\more.lkb

progs\edlin.prg: progs\edlin.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) edlin.asm

bin\edlin: progs\edlin.prg lib\env.prg lib\lineedit.prg bin
	$(LINK) $(LFLAGS) -o bin\edlin progs\edlin.prg lib\env.prg lib\lineedit.prg
	-del /F /Q bin\edlin.lkb

progs\move.prg: progs\move.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) move.asm

bin\move: progs\move.prg lib\move.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\move progs\move.prg lib\move.prg lib\file_glob.prg
	-del /F /Q bin\move.lkb

progs\shell.prg: progs\shell.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) shell.asm

bin\shell: progs\shell.prg lib\env.prg bin
	$(LINK) $(LFLAGS) -o bin\shell progs\shell.prg lib\env.prg
	-del /F /Q bin\shell.lkb

progs\yr.prg: progs\yr.asm include\kernel_api.inc include\bios.inc include\opcodes.def include\ymodem.inc
	cd progs && $(ASM) $(ASMFLAGS) yr.asm

bin\yr: progs\yr.prg lib\ymodem.prg lib\fmt32.prg bin
	$(LINK) $(LFLAGS) -o bin\yr progs\yr.prg lib\ymodem.prg lib\fmt32.prg
	-del /F /Q bin\yr.lkb

progs\ys.prg: progs\ys.asm include\kernel_api.inc include\bios.inc include\opcodes.def include\ymodem.inc include\file_glob.inc
	cd progs && $(ASM) $(ASMFLAGS) ys.asm

bin\ys: progs\ys.prg lib\ymodem.prg lib\fmt32.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\ys progs\ys.prg lib\ymodem.prg lib\fmt32.prg lib\file_glob.prg
	-del /F /Q bin\ys.lkb

progs\dir.prg: progs\dir.asm include\kernel_api.inc include\bios.inc include\opcodes.def include\file_glob.inc include\vollabel.inc
	cd progs && $(ASM) $(ASMFLAGS) dir.asm

bin\dir: progs\dir.prg lib\fmt32.prg lib\file_glob.prg lib\vollabel.prg lib\pathstr.prg bin
	$(LINK) $(LFLAGS) -o bin\dir progs\dir.prg lib\fmt32.prg lib\file_glob.prg lib\vollabel.prg lib\pathstr.prg
	-del /F /Q bin\dir.lkb

progs\label.prg: progs\label.asm include\kernel_api.inc include\opcodes.def include\vollabel.inc
	cd progs && $(ASM) $(ASMFLAGS) label.asm

bin\label: progs\label.prg lib\vollabel.prg bin
	$(LINK) $(LFLAGS) -o bin\label progs\label.prg lib\vollabel.prg
	-del /F /Q bin\label.lkb

progs\pwd.prg: progs\pwd.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) pwd.asm

bin\pwd: progs\pwd.prg lib\pathstr.prg bin
	$(LINK) $(LFLAGS) -o bin\pwd progs\pwd.prg lib\pathstr.prg
	-del /F /Q bin\pwd.lkb

progs\del.prg: progs\del.asm include\kernel_api.inc include\opcodes.def include\file_glob.inc
	cd progs && $(ASM) $(ASMFLAGS) del.asm

bin\del: progs\del.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\del progs\del.prg lib\file_glob.prg
	-del /F /Q bin\del.lkb

progs\touch.prg: progs\touch.asm include\kernel_api.inc include\opcodes.def include\file_glob.inc
	cd progs && $(ASM) $(ASMFLAGS) touch.asm

bin\touch: progs\touch.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\touch progs\touch.prg lib\file_glob.prg
	-del /F /Q bin\touch.lkb

progs\copy.prg: progs\copy.asm include\kernel_api.inc include\bios.inc include\opcodes.def include\file_glob.inc
	cd progs && $(ASM) $(ASMFLAGS) copy.asm

bin\copy: progs\copy.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\copy progs\copy.prg lib\file_glob.prg
	-del /F /Q bin\copy.lkb

progs\attrib.prg: progs\attrib.asm include\kernel_api.inc include\opcodes.def include\file_glob.inc
	cd progs && $(ASM) $(ASMFLAGS) attrib.asm

bin\attrib: progs\attrib.prg lib\file_glob.prg bin
	$(LINK) $(LFLAGS) -o bin\attrib progs\attrib.prg lib\file_glob.prg
	-del /F /Q bin\attrib.lkb

progs\stat.prg: progs\stat.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) stat.asm

bin\stat: progs\stat.prg lib\fmt32.prg bin
	$(LINK) $(LFLAGS) -o bin\stat progs\stat.prg lib\fmt32.prg
	-del /F /Q bin\stat.lkb

progs\chkdsk.prg: progs\chkdsk.asm include\kernel_api.inc include\bios.inc include\opcodes.def
	cd progs && $(ASM) $(ASMFLAGS) chkdsk.asm

bin\chkdsk: progs\chkdsk.prg lib\fmt32.prg bin
	$(LINK) $(LFLAGS) -o bin\chkdsk progs\chkdsk.prg lib\fmt32.prg
	-del /F /Q bin\chkdsk.lkb

#------------------------------------------------------------------
# Link rules (boot/kernel)
#------------------------------------------------------------------

$(MBR_BIN): boot\mbr.prg
	$(LINK) $(LFLAGS) -o $(MBR_BIN) boot\mbr.prg

$(KRNBOOT_BIN): boot\krnboot.prg
	$(LINK) $(LFLAGS) -o $(KRNBOOT_BIN) boot\krnboot.prg

# python3 (any recent version, on PATH) runs the same margin guard the
# Linux build does -- see tools\check_kernel_margin.py's own header.
# Catches a real bug class (an uninitialized kernel buffer silently left
# out of the linked binary) before it ever reaches hardware.
$(KERNEL_BIN): $(KOBJ)
	$(LINK) $(LFLAGS) -o $(KERNEL_BIN) $(KOBJ)
	python3 tools\check_kernel_margin.py

#------------------------------------------------------------------
# Concatenate bootstrap + kernel proper into the final install image --
# same layout as the Linux Makefile's own FULL_BIN rule (krnboot.bin
# then kernel.bin). copy /b does a binary-safe concatenation, the
# Windows equivalent of "cat a b > c".
#------------------------------------------------------------------
$(FULL_BIN): $(KRNBOOT_BIN) $(KERNEL_BIN)
	copy /b /y $(KRNBOOT_BIN)+$(KERNEL_BIN) $(FULL_BIN)

#------------------------------------------------------------------
# Convenience targets
#------------------------------------------------------------------

mbr: $(MBR_BIN)

# Build every progs\*.asm into bin\<name> (bare name, no extension --
# matches the on-device \bin layout), plus bin\batch.mod (the loadable
# batch-script module -- required for .bat scripts to work at all,
# matching the Linux Makefile's own "progs: $(PROG_EXES) bin/batch.mod").
# The SPECIAL_BINS programs get real nmake incremental rebuilds;
# everything else is auto-discovered and (re)built by build_progs.bat --
# see this file's own header comment for why the split exists.
progs: bin $(SPECIAL_BINS) bin\batch.mod
	build_progs.bat "$(ASM)" "$(ASMFLAGS)" "$(LINK)" "$(LFLAGS)"

# Build every test\*.asm into test\bin\<name> -- diagnostic/subsystem-
# exercising programs, kept out of bin\ entirely so a normal install's
# \bin never includes them. Same split as "progs" above: the
# TEST_SPECIAL_BINS ones via real nmake rules, everything else
# auto-discovered by build_test.bat.
test: test\bin $(TEST_SPECIAL_BINS)
	build_test.bat "$(ASM)" "$(ASMFLAGS)" "$(LINK)" "$(LFLAGS)"

# sys\elfdos-sys.exe: the host-side installer, compiled from sys\sys.c
# with MSVC (see this file's own header comment). cd's into sys\ to
# match cl's own default output-naming convention (plain "cl sys.c"
# would otherwise produce sys.exe, not elfdos-sys.exe) -- same "cd DIR
# && tool file" shape every asm02 rule above already uses.
sys\elfdos-sys.exe: sys\sys.c
	cd sys && $(SYSCC) $(SYSCFLAGS) /Fe:elfdos-sys.exe sys.c

# Full install: write MBR boot code and kernel to disk. Use this when
# setting up a new disk or after changing the MBR. check_dev.bat refuses
# to run at all if DEV wasn't given explicitly -- see this file's own
# header comment for why there's no default to fall back to.
install: $(FULL_BIN) $(MBR_BIN) sys\elfdos-sys.exe
	check_dev.bat "$(DEV)" install
	$(SYS) -m $(MBR_BIN) -k $(FULL_BIN) $(DEV)

# Kernel-only update: MBR already on disk, just refresh the kernel.
# Faster for routine kernel development and testing cycles.
update: $(FULL_BIN) sys\elfdos-sys.exe
	check_dev.bat "$(DEV)" update
	$(SYS) -k $(FULL_BIN) $(DEV)

clean:
	-del /F /Q boot\*.prg boot\*.lst
	-del /F /Q kernel\*.prg kernel\*.lst
	-del /F /Q progs\*.prg progs\*.lst progs\*.build progs\*.lkb
	-del /F /Q test\*.prg test\*.lst test\*.build test\*.lkb
	-del /F /Q lib\*.prg lib\*.lst
	-del /F /Q sys\elfdos-sys.exe sys\sys.obj
	-del /F /Q $(MBR_BIN) $(KRNBOOT_BIN) $(KERNEL_BIN) $(FULL_BIN)
	-if exist bin rmdir /S /Q bin
	-if exist test\bin rmdir /S /Q test\bin
